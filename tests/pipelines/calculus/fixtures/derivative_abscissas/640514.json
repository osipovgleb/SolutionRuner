age_1"]}, "operation": "rewrite", "transformation_target_id": "section:condition:1"}, {"at": "2026-10-02T17:09:08.905685+00:00", "by": {"type": "pipeline", "stage": "deterministic_svg"}, "value": {"html": "<p><img alt=\"\" data-asset-id=\"d8693c44-2a64-4c8e-849e-2de910bf3ba6\" data-asset-key=\"image_2\" data-transformation-target-id=\"asset:image_2\"/>Зна­че­ние про­из­вод­ной в точке ка­са­ния равно уг­ло­во­му ко­эф­фи­ци­ен­ту ка­са­тель­ной. По­сколь­ку ка­са­тель­ная па­рал­лель­на пря­мой <i>y</i>  =  <i>x</i> − 2 или сов­па­да­ет с ней, она имеет  уг­ло­вой ко­эф­фи­ци­ент рав­ный 1, а по­то­му и <span data-inline-latex=\"f'(x_0)=1\"></span>. Оста­лось найти, при каких <i>x</i> про­из­вод­ная при­ни­ма­ет зна­че­ние 1. Ис­ко­мая точка <i>x</i><sub>0</sub>  =  3 (см. рис.).</p>", "title": "Решение", "asset_keys": ["image_2"]}, "operation": "rewrite", "transformation_target_id": "section:solution:1"}, {"at": "2026-10-02T17:09:08.905685+00:00", "by": {"type": "pipeline", "stage": "deterministic_svg"}, "operation": "remove", "transformation_target_id": "asset:formula_1"}, {"at": "2026-10-02T17:09:08.905685+00:00", "by": {"type": "pipeline", "stage": "deterministic_svg"}, "operation": "remove", "transformation_target_id": "asset:formula_2"}]}, "normalized_content": {"assets": [{"alt": "", "url": "/assets/1006d9fe-c395-453b-a128-f192e89f295d", "kind": "ordinary_image", "asset_id": "1006d9fe-c395-453b-a128-f192e89f295d", "asset_key": "image_1", "transformation_target_id": "asset:image_1"}, {"alt": "", "url": "/assets/d8693c44-2a64-4c8e-849e-2de910bf3ba6", "kind": "ordinary_image", "asset_id": "d8693c44-2a64-4c8e-849e-2de910bf3ba6", "asset_key": "image_2", "transformation_target_id": "asset:image_2"}], "format": "teacherhelper-normalized", "sections": [{"key": "condition", "html": "<p><img alt=\"\" data-asset-id=\"1006d9fe-c395-453b-a128-f192e89f295d\" data-asset-key=\"image_1\" data-transformation-target-id=\"asset:image_1\" src=\"/assets/1006d9fe-c395-453b-a128-f19