keys": ["image_2"], "section_id": "solution:1", "transformation_target_id": "section:solution:1"}], "schema_version": 3, "problem_reference_ids": {"prototype_problem_id": null, "group_parent_problem_id": null, "adjacent_group_parent_problem_id": null}}}