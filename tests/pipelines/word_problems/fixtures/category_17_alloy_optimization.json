                "url": "/assets/e7d12b7b-6935-4703-be95-8a189ffb8472",
                "html": "<img alt=\"\" data-asset-id=\"e7d12b7b-6935-4703-be95-8a189ffb8472\" data-asset-key=\"image_1\" data-transformation-target-id=\"asset:image_1\" src=\"/assets/e7d12b7b-6935-4703-be95-8a189ffb8472\"/>",
                "kind": "ordinary_image",
                "asset_id": "e7d12b7b-6935-4703-be95-8a189ffb8472",
                "position": 7,
                "asset_key": "image_1",
