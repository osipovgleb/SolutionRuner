 4, тогда</p><center><p><span data-inline-latex=\"3+\\frac{a-12}{-1+4}=4\\iff \\frac{a-12}{3}=1\\iff a-12=3\\iff a=15\"></span>. </p></center>", "title": "Решение", "asset_keys": [], "section_id": "solution:1", "transformation_target_id": "section:solution:1"}], "schema_version": 3, "problem_reference_ids": {"prototype_problem_id": null, "group_parent_problem_id": null, "adjacent_group_parent_problem_id": null}}}