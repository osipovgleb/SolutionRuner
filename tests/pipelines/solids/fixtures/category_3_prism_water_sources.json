                "html": "<img alt=\"\" data-asset-id=\"f69fb42f-bb37-40b5-ab93-ada008c5b714\" data-asset-key=\"image_1\" data-transformation-target-id=\"asset:image_1\" src=\"/assets/f69fb42f-bb37-40b5-ab93-ada008c5b714\"/>",
                "kind": "ordinary_image",
