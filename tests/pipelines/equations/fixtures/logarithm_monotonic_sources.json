            "value": {
              "html": "<p>Ре­ши­те не­ра­вен­ство  <span data-inline-latex=\"(5x-13)\\cdot \\log_{(2x-5)} (x^{2}-6x+10)\\ge 0\"></span>.</p>",
              "title": "Условие",
              "asset_keys": []
            },
            "operation": "rewrite",
            "transformation_target_id": "section:condition:1"
          },
          {
            "at": "2026-10-01T22:56:17.739391+00:00",
