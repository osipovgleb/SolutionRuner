                "type": "pipeline",
                "stage": "deterministic_svg"
              },
              "value": {
                "html": "<p>а)  <span data-inline-latex=\"\\{\\frac{5\\pi}{18}+\\frac{2\\pi k}{3};\\frac{\\pi}{6}+2\\pi k\\mid k\\in\\mathbb{Z}\\}\"></span> ;  б)  <span data-inline-latex=\"-\\frac{11\\pi}{6}\"></span> ,   <span data-inline-latex=\"-\\frac{19\\pi}{18}\"></span> ,   <span data-inline-latex=\"-\\frac{31\\pi}{18}\"></span> . </p>",
                "title": "Ответ",
                "asset_keys": []
              },
              "operation": "rewrite",
              "transformation_target_id": "section:answer:1"
            },
            {
