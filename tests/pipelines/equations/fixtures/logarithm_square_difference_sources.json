              "stage": "deterministic_svg"
            },
            "value": {
              "html": "<p> <span data-inline-latex=\"(-5;-2{,}5)\\cup (-1{,}5;0)\"></span> .</p>",
              "title": "Ответ",
              "asset_keys": []
            },
            "operation": "rewrite",
