              "stage": "deterministic_svg"
            },
            "value": {
              "html": "<p>Ре­ши­те не­ра­вен­ство  <span data-inline-latex=\"\\log_{(5)}^{2} \\frac{(x-4)^{2}\\cdot (x-3)}{48}\\gt \\log_{(0{,}2)}^{2} \\frac{x-3}{3}\"></span> . </p>",
              "title": "Условие",
              "asset_keys": []
            },
            "operation": "rewrite",
            "transformation_target_id": "section:condition:1"
          },
          {
            "at": "2026-10-02T09:35:13.979428+00:00",
