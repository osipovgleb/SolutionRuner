          "format": "teacherhelper-normalized",
          "sections": [
            {
              "key": "condition",
              "html": "<ol data-layout=\"source-subparts\" type=\"a\"><li data-list-marker=\"а)\">Ре­ши­те урав­не­ние: <span data-inline-latex=\"4^{x}-2^{x+3}+15=0\"></span>.</li><li data-list-marker=\"б)\">Опре­де­ли­те, какие из его кор­ней при­над­ле­жат от­рез­ку  <span data-inline-latex=\"[2;\\sqrt{10}]\"></span> .</li></ol>",
              "title": "Условие",
              "asset_keys": [],
              "section_id": "condition:1",
              "transformation_target_id": "section:condition:1"
            },
            {
              "key": "answer",
              "html": "<p>а)  <span data-inline-latex=\"\\{\\log_2 3;\\log_2 5\\}\"></span> ; б) <span data-inline-latex=\"\\log_2 5\"></span>.</p>",
              "title": "Ответ",
              "asset_keys": [],
              "section_id": "answer:1",
