              "html": "<img alt=\"\" data-asset-id=\"49728f1c-ccc5-4c0d-af76-8363791b4c66\" data-asset-key=\"image_1\" data-transformation-target-id=\"asset:image_1\" src=\"/assets/49728f1c-ccc5-4c0d-af76-8363791b4c66\"/>",
              "kind": "ordinary_image",
