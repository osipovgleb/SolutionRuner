                "stage": "deterministic_svg"
              },
              "value": {
                "html": "<p>а)  <span data-inline-latex=\"\\{-2;\\frac{1}{2};\\frac{\\pi}{3}+2\\pi n;\\frac{2\\pi}{3}+2\\pi n\\mid n\\in\\mathbb{Z}\\}\"></span> ;  б)  <span data-inline-latex=\"-2,\\,\\frac{1}{2},\\,\\frac{\\pi}{3}\"></span> . </p>",
