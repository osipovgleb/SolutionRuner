                "type": "pipeline",
                "stage": "deterministic_svg"
              },
              "value": {
                "html": "<p>а)  <span data-inline-latex=\"\\{4;-\\frac{3}{2};\\frac{2\\pi}{3}+2\\pi k;-\\frac{2\\pi}{3}+2\\pi k\\mid k\\in\\mathbb{Z}\\}\"></span> ;  б)  <span data-inline-latex=\"-\\frac{3}{2},\\,\\frac{2\\pi}{3}\"></span> . </p>",
