              "by": {
                "type": "pipeline",
                "stage": "deterministic_svg"
              },
              "value": {
                "html": "<p>а)  <span data-inline-latex=\"\\{-\\frac{2\\pi}{3}+2\\pi k,-\\frac{\\pi}{2}+2\\pi k\\mid k\\in\\mathbb{Z}\\}\"></span> ;  б)   <span data-inline-latex=\"\\frac{4\\pi}{3},\\,\\frac{3\\pi}{2}\"></span> . </p>",
                "title": "Ответ",
                "asset_keys": []
              },
              "operation": "rewrite",
