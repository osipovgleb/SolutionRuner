            "value": {
              "html": "<p>Ре­ши­те не­ра­вен­ство: <span data-inline-latex=\"\\left|\\frac{2}{3}x-\\frac{2}{3}\\right|.^{(x-1{,}2)}+\\left|\\frac{2}{3}x-\\frac{2}{3}\\right|^{1{,}2-x}\\le 2\"></span>. </p>",
              "title": "Условие",
              "asset_keys": []
            },
            "operation": "rewrite",
            "transformation_target_id": "section:condition:1"
          },
          {
            "at": "2026-10-02T05:15:46.539951+00:00",
