              "value": {
                "alt": "",
                "url": "/assets/056d896b-1dd8-40a2-99b2-cee586b7670a",
                "html": "<img alt=\"\" data-asset-id=\"056d896b-1dd8-40a2-99b2-cee586b7670a\" data-asset-key=\"image_1\" data-transformation-target-id=\"asset:image_1\" src=\"/assets/056d896b-1dd8-40a2-99b2-cee586b7670a\"/>",
                "kind": "ordinary_image",
                "asset_id": "056d896b-1dd8-40a2-99b2-cee586b7670a",
                "position": 4,
