              "type": "pipeline",
              "stage": "deterministic_svg"
            },
            "value": {
              "html": "<p> <span data-inline-latex=\"(-\\infty;-2]\\cup [1;\\frac{4}{3}]\"></span> .</p>",
              "title": "Ответ",
              "asset_keys": []
            },
            "operation": "rewrite",
            "transformation_target_id": "section:answer:1"
