            "value": {
              "html": "<p>Ре­ши­те не­ра­вен­ство  <span data-inline-latex=\"\\log_{(x^{2}+1)} (x-3)^{2}\\cdot \\log_{(x^{2}+1)} \\frac{(x-3)^{2}}{(x^{2}+1)^{3}}\\le -2\"></span>. </p>",
              "title": "Условие",
              "asset_keys": []
            },
            "operation": "rewrite",
            "transformation_target_id": "section:condition:1"
          },
          {
            "at": "2026-10-02T07:34:22.374922+00:00",
