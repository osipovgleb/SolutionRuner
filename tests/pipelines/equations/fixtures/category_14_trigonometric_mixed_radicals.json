                "html": "<img alt=\"\" data-asset-id=\"24ff0f54-3123-4d1c-b4f7-539783346e1c\" data-asset-key=\"image_1\" data-transformation-target-id=\"asset:image_1\" src=\"/assets/24ff0f54-3123-4d1c-b4f7-539783346e1c\"/>",
                "kind": "ordinary_image",
