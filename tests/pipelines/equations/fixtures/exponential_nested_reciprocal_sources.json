            },
            "value": {
              "html": "<p> <span data-inline-latex=\"(-\\infty;-\\sqrt{2})\\cup (-\\sqrt{2};-1]\\cup \\{0\\}\\cup [1;\\sqrt{2})\\cup (\\sqrt{2};+\\infty)\"></span> .</p>",
              "title": "Ответ",
              "asset_keys": []
