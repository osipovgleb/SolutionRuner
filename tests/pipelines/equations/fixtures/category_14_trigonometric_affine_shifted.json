              },
              "value": {
                "alt": "",
                "url": "/assets/b100938d-b3e1-4867-9bd9-617ce4f889c9",
                "html": "<img alt=\"\" data-asset-id=\"b100938d-b3e1-4867-9bd9-617ce4f889c9\" data-asset-key=\"image_1\" data-transformation-target-id=\"asset:image_1\" src=\"/assets/b100938d-b3e1-4867-9bd9-617ce4f889c9\"/>",
                "kind": "ordinary_image",
                "asset_id": "b100938d-b3e1-4867-9bd9-617ce4f889c9",
                "position": 8,
                "asset_key": "image_1",
