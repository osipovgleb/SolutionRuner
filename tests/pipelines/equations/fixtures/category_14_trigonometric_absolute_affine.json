            {
              "key": "source",
              "html": "<p>Источник: <a href=\"https://math-ege.sdamgia.ru/test?id=37008772\" rel=\"noreferrer noopener\" target=\"_blank\">А. Ларин. Тренировочный вариант № 342</a></p>",
